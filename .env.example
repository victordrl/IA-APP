# ── Server ──────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# ── Exchange (CCXT) ─────────────────────────────────
# No API keys needed for public market data
EXCHANGE_ID=binance
EXCHANGE_RATE_LIMIT=true

# ── Data Defaults ───────────────────────────────────
DEFAULT_SYMBOL=BTC/USDT
DEFAULT_TIMEFRAMES=1h,4h,1d

# ── Tensor ──────────────────────────────────────────
TENSOR_WINDOW_SIZE=30

# ── Replay ──────────────────────────────────────────
REPLAY_SPEED_MULTIPLIER=1.0
REPLAY_REFRESH_SECONDS=5
